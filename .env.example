# ==============================================================================
# RecoverOS — AI Revenue Recovery Orchestrator Environment Configuration
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./recovery_orchestrator.db

# ------------------------------------------------------------------------------
# Free Cloud LLM API Keys (Plug in any free key to enable live cloud agents)
# ------------------------------------------------------------------------------
# 1. Google Gemini (Free Tier: Gemini 2.0 Flash / 1.5 Flash)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq (Free Tier: Llama 3.3 70B, Qwen 2.5 32B)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=

# 3. OpenAI / OpenRouter (Optional)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama fallback (if running locally)
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_LOCAL_MODEL=qwen3:8b

# ------------------------------------------------------------------------------
# Razorpay / Payment Gateway Test Mode
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret_12345

# ------------------------------------------------------------------------------
# Deterministic Governance & Policy Thresholds
# ------------------------------------------------------------------------------
MAX_ATTEMPTS_PER_CASE=2
MAX_ACTIVE_CHARGE_ACTIONS=1
ATTRIBUTION_WINDOW_MINUTES=60
MAX_MESSAGES_24H=2
QUIET_HOURS_START=22
QUIET_HOURS_END=8
HIGH_VALUE_THRESHOLD=10000.0
HUMAN_REVIEW_THRESHOLD=25000.0
INCENTIVE_ENABLED=false
MAX_DISCOUNT_PERCENTAGE=0.10
MAX_ABSOLUTE_DISCOUNT=500.0
